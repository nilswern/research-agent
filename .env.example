# --- LLM (required) ---
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-key-here
LLM_MODEL=gemini-3.8-flash
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=3

# --- Embeddings (local, no API calls) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# --- ChromaDB ---
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=research_documents
CACHE_MAX_AGE_DAYS=30

# --- Chunking / Retrieval ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5

# --- Research budget ---
MAX_RESEARCH_STEPS=5
MAX_RESULTS_PER_SEARCH=5
MAX_REPORT_REPAIRS=1

# --- Web scraper ---
SCRAPER_TIMEOUT=20
SCRAPER_MAX_CHARS=20000
# Höflicher User-Agent: Name/Version plus eine Kontaktadresse, z. B.
# ResearchPilot/0.1 (https://github.com/<user>/research-agent)
USER_AGENT=ResearchPilot/0.1

# --- Output ---
OUTPUT_LANGUAGE=en
REPORTS_DIR=reports
STREAM_FINAL_ANSWER=true

# --- Logging ---
LOG_LEVEL=INFO
